# ===============================================
# HealOps - Autonomous SRE Agent Layer 1 Config
# ===============================================

# Model Provider: "gemini", "bedrock", "openai", "anthropic", "ollama", "litellm"
MODEL_PROVIDER=gemini

# Google Gemini Configuration
GEMINI_MODEL_ID=gemini-2.0-flash
GEMINI_API_KEY=your_gemini_api_key_here

# AWS Bedrock Configuration (if using Bedrock)
BEDROCK_MODEL_ID=anthropic.claude-3-5-sonnet-20241022-v2:0
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=

# OpenAI Configuration (if using OpenAI)
OPENAI_MODEL_ID=gpt-4o
OPENAI_API_KEY=your_openai_api_key_here

# Anthropic Configuration (if using Anthropic direct)
ANTHROPIC_MODEL_ID=claude-3-5-sonnet-20241022
ANTHROPIC_API_KEY=your_anthropic_api_key_here

# Ollama Configuration (for 100% offline local inference)
OLLAMA_MODEL_ID=llama3.2
OLLAMA_HOST=http://localhost:11434

# Redis State & Session Configuration
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_DB=0
REDIS_PASSWORD=
REDIS_NAMESPACE=healops:sessions
SESSION_TTL_SECONDS=86400
